# syntax=docker/dockerfile:1
# Imagem do fleet-ui para ROS 2 Humble (compatível com TurtleBot4 real)
#
# Use para conectar ao robô real (Humble):
#   make robot-build-humble
#   make robot-up-humble ROBOT_NAMESPACE=tb1 ROBOT_IP=192.168.50.11
#
# A imagem Jazzy (Dockerfile padrão) continua sendo usada para simulação.

FROM ros:humble-ros-base-jammy

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8 \
    ROS_DISTRO=humble \
    FLEET_ROOT=/workspace

SHELL ["/bin/bash", "-c"]

# Dependências base + ROS 2 Humble
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    gnupg \
    locales \
    lsb-release \
    software-properties-common \
    build-essential \
    git \
    python3-colcon-common-extensions \
    python3-pip \
    python3-yaml \
    ros-dev-tools \
  && locale-gen en_US.UTF-8 \
  && rm -rf /var/lib/apt/lists/*

# Pacotes ROS 2 Humble para navegação
# Nota: nav2-minimal-tb4-sim não existe no Humble, usamos os pacotes separados
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-navigation2 \
    ros-humble-nav2-bringup \
    ros-humble-slam-toolbox \
    ros-humble-rmw-cyclonedds-cpp \
    ros-humble-tf2-py \
    ros-humble-tf2-ros \
    ros-humble-tf2-tools \
    ros-humble-topic-tools \
    ros-humble-rosbag2 \
    ros-humble-rosbag2-storage-default-plugins \
  && rm -rf /var/lib/apt/lists/*

# TurtleBot4 navigation (disponível no Humble)
RUN apt-get update && apt-get install -y --no-install-recommends \
    ros-humble-turtlebot4-navigation \
  && rm -rf /var/lib/apt/lists/* || echo "turtlebot4-navigation not available, continuing..."

# Node.js para o frontend
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
  && apt-get install -y --no-install-recommends nodejs \
  && rm -rf /var/lib/apt/lists/*

WORKDIR ${FLEET_ROOT}

# Dependências Python do backend
# Nota: no Humble/Ubuntu 22.04, alguns pacotes Python são diferentes
RUN pip3 install --no-cache-dir \
    fastapi>=0.100.0 \
    uvicorn>=0.22.0 \
    websockets>=11.0 \
    httpx>=0.24.0 \
    anthropic>=0.25.0 \
    numpy>=1.24.0 \
    pyyaml>=6.0 \
    pandas>=1.5.0 \
    matplotlib>=3.7.0 \
    seaborn>=0.12.0

COPY frontend/package*.json ${FLEET_ROOT}/frontend/
RUN npm --prefix frontend ci

COPY . ${FLEET_ROOT}

# Build do workspace ROS 2
RUN chmod +x docker/*.sh \
  && source /opt/ros/humble/setup.bash \
  && cd fleet_ws \
  && colcon build --symlink-install \
  && bash fix_ament_hooks.sh || true

# Build do frontend
RUN npm --prefix frontend run build

ENTRYPOINT ["/workspace/docker/entrypoint.sh"]
CMD ["bash"]
